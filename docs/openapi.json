  },
  "components": {
    "schemas": {
      "Body_submit_change_api_v1_changes_post": {
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Description"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity",
            "default": "normal"
          },
          "photos": {
            "items": {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            "type": "array",
            "title": "Photos"
          },
          "title": {
            "type": "string",
            "maxLength": 120,
            "title": "Title",
            "default": ""
          },
          "project_id": {
            "type": "string",
            "enum": [
              "north-park",
              "harbor",
              "cedar"
            ],
            "title": "Project Id",
            "default": "north-park"
          },
          "submitted_by": {
            "type": "string",
            "enum": [
              "contractor",
              "subcontractor"
            ],
            "title": "Submitted By",
            "default": "contractor"
          }
        },
        "type": "object",
        "required": [
          "description",
          "photos"
        ],
        "title": "Body_submit_change_api_v1_changes_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "HistoryEvent": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "changeId": {
            "type": "string",
            "title": "Changeid"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "person": {
            "type": "string",
            "title": "Person"
          },
          "time": {
            "type": "string",
            "title": "Time"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          }
        },
        "type": "object",
        "required": [
          "id",
          "changeId",
          "title",
          "person",
          "time",
          "kind"
        ],
        "title": "HistoryEvent"
      },
      "ReviewTerms": {
        "properties": {
          "scope": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Scope"
          },
          "amount": {
            "type": "number",
            "multipleOf": 0.01,
            "maximum": 100000000.0,
            "minimum": 0.0,
            "title": "Amount"
          },
          "impact_days": {
            "type": "integer",
            "maximum": 3650.0,
            "minimum": 0.0,
            "title": "Impact Days"
          }
        },
        "type": "object",
        "required": [
          "amount",
          "impact_days"
        ],
        "title": "ReviewTerms"
      },
      "Severity": {
        "type": "string",
        "enum": [
          "normal",
          "high"
        ],
        "title": "Severity"
      },
      "Status": {
        "type": "string",
        "enum": [
          "submitted",
          "awaiting_client",
          "approved",
          "rejected"
        ],
        "title": "Status"
      },
      "Suggestion": {
        "properties": {
          "scope": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Scope"
          },
          "amount": {
            "type": "number",
            "multipleOf": 0.01,
            "maximum": 100000000.0,
            "minimum": 0.0,
            "title": "Amount"
          },
          "impact_days": {
            "type": "integer",
            "maximum": 3650.0,
            "minimum": 0.0,
            "title": "Impact Days"
          },
          "rationale": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Rationale"
          },
          "in_scope": {
            "type": "boolean",
            "title": "In Scope"
          }
        },
        "type": "object",
        "required": [
          "scope",
          "amount",
          "impact_days",
          "rationale",
          "in_scope"
        ],
        "title": "Suggestion"
      },
      "SuggestionRequest": {
        "properties": {
          "original_scope": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 10,
            "title": "Original Scope"
          }
        },
        "type": "object",
        "required": [
          "original_scope"
        ],
        "title": "SuggestionRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorkspaceChangeOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Description"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "photo_keys": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Photo Keys"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "project_id": {
            "type": "string",
            "title": "Project Id"
          },
          "submitted_by": {
            "type": "string",
            "title": "Submitted By"
          },
          "author": {
            "type": "string",
            "title": "Author"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "amount": {
            "type": "number",
            "title": "Amount"
          },
          "impact_days": {
            "type": "integer",
            "title": "Impact Days"
          },
          "sent_for_approval": {
            "type": "boolean",
            "title": "Sent For Approval"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryEvent"
            },
            "type": "array",
            "title": "History"
          },
          "suggestion": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Suggestion"
              },
              {
                "type": "null"
              }
            ]
          },
          "approved_scope": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approved Scope"
          }
        },
        "type": "object",
        "required": [
          "id",
          "description",
          "severity",
          "status",
          "code",
          "title",
          "project_id",
          "submitted_by",
          "author",
          "created_at",
          "amount",
          "impact_days",
          "sent_for_approval",
          "history"
        ],
        "title": "WorkspaceChangeOut"
      }
    }
  }
}

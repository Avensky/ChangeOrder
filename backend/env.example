# Browser origins allowed to call the API. Add a LAN web origin if needed.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Phone-accessible frontend URL used in approval links.
APP_URL=http://localhost:8081
# Optional: local durable prototype store (default backend/workspace.sqlite3).
# WORKSPACE_DB_PATH=/path/to/workspace.sqlite3
# Optional Bedrock Converse model. Use the server's normal AWS credential chain.
# BEDROCK_MODEL_ID=your-image-capable-model-or-inference-profile
# AWS_REGION=us-east-1
# Optional email delivery for the GC approval link. With no key set, the link
# is printed to the backend console instead, which is enough for the demo.
# Put the real key in your local .env only; never commit it.
# EMAIL_API_KEY=your-provider-key
# EMAIL_API_URL=https://api.resend.com/emails
# EMAIL_FROM=ChangeOrder <onboarding@resend.dev>
# Where the GC approval link is sent while there is no user table.
# GC_EMAIL=gc@example.com
